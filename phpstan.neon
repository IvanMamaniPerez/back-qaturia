includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Scramble's public rule helpers reference these aliases from its own PHPStan config.
    typeAliases:
        Rule: 'string|\Illuminate\Contracts\Validation\ValidationRule'
        RuleSet: 'Rule|Rule[]'

    level: 7

    ignoreErrors:
        -
            identifier: missingType.return
            path: database/migrations/2024_01_01_*.php
