# Copy to .env for LOCAL use only. Never reuse these example credentials in production.
APP_NAME="QATUR IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Lima

APP_PORT=8085
DB_FORWARD_PORT=5434
REDIS_FORWARD_PORT=6381
MAILPIT_DASHBOARD_PORT=8026
VITE_PORT=5173
IMAGE_TAG=local

# Initial boot without laravel/octane. Switch to octane after installation.
APP_HTTP_SERVER=artisan
OCTANE_WORKERS=2
OCTANE_TASK_WORKERS=2
OCTANE_MAX_REQUESTS=500
OCTANE_WATCH=false
OCTANE_HTTPS=false

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=qaturia
DB_USERNAME=qaturia
DB_PASSWORD=change_me_local_only

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@qaturia.local"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: enable only after php artisan install:broadcasting.
REVERB_APP_ID=qaturia-local
REVERB_APP_KEY=qaturia-local-key
REVERB_APP_SECRET=replace-this-in-production
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8085
VITE_REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
